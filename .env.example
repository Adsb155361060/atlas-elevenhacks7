# Atlas environment template.
#
# Copy to `.env.local` (gitignored) and fill in the values.
# Loading paths:
#   - Dev (Linux/macOS): direnv or `set -a; . ./.env.local; set +a`
#   - Worker prod:       wrangler secret put <KEY> <VALUE>
#   - Desktop prod:      OS keyring (Tauri's tauri-plugin-store) — onboarding wizard saves voice_id; other secrets live in env.

# ───────────────────────── REQUIRED for judges to demo the voice loop ─────────────────────────

# Anthropic key — Claude routes every voice turn through this. Get one at
# https://console.anthropic.com/settings/keys. Free $5 trial credit covers
# ~500 demo turns. Format: sk-ant-api03-…
ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs key — STT (Scribe v2) + TTS (Flash v2.5) + IVC clone. Get one
# at https://elevenlabs.io/app/settings/api-keys. Free tier gives 10k chars
# of TTS per month; demo session uses ~2k. Format: sk_…
ELEVENLABS_API_KEY=sk_...

# ElevenLabs agent id created via scripts/create-agent.sh (or the dashboard).
# This is what the desktop app connects its WebSocket to.
ELEVENLABS_AGENT_ID=agent_...
ATLAS_AGENT_ID=agent_...

# Shared secret(s) the agent presents on every custom-LLM call back to the
# Worker. Comma-separated so you can rotate without redeploying.
# Generate with: ./scripts/gen-agent-token.sh
ALLOWED_AGENT_TOKENS=replace-with-strong-random

# Worker URL after `wrangler deploy`. Both vars point at the same URL — they
# exist because the Worker uses one name and the desktop uses the other for
# historical reasons.
WORKER_PUBLIC_URL=https://atlas-worker.example.workers.dev
ATLAS_WORKER_URL=https://atlas-worker.example.workers.dev

# ───────────────────────── OPTIONAL (features degrade gracefully without these) ─────────────────────────

# Brave Search — used by the `web_search` tool. Without it, search queries
# (`what's the weather`, `who won the F1 race`) return a clean
# `configuration_error`. Free tier is 2000 queries/month at
# https://api.search.brave.com/app/keys.
BRAVE_SEARCH_API_KEY=...

# Cost guardrails (Worker enforces; bypass requires explicit override).
DAILY_ANTHROPIC_BUDGET_USD=20
DAILY_ELEVENLABS_BUDGET_USD=15

# ───────────────────────── NOT NEEDED for the judge demo ─────────────────────────

# Gemini — Phase 11 multi-provider fallback.
GEMINI_API_KEY=...
# Voyage AI — Phase 5.2 embeddings for memory.
VOYAGE_API_KEY=...
# OpenAI — Phase 11 fallback; not in the V1 demo path.
OPENAI_API_KEY=sk-...
# Picovoice — ADR 0014 superseded by ADR 0019 (rustpotter→livekit-wakeword).
# Atlas does NOT use Picovoice today. Leave the placeholder; we don't read it.
ATLAS_PICOVOICE_ACCESS_KEY=...

# ───────────────────────── Local-only ─────────────────────────

ATLAS_LOG_LEVEL=info
ATLAS_TELEMETRY_OPT_IN=false
WEB_PUBLIC_URL=http://localhost:3000
