{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atlas",
  "version": "0.0.1",
  "identifier": "com.atlas.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atlas",
        "width": 920,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": true,
        "fullscreen": false,
        "center": true
      },
      {
        "label": "mini",
        "title": "Atlas (mini)",
        "url": "index.html?mode=mini",
        "width": 320,
        "height": 96,
        "minWidth": 220,
        "minHeight": 72,
        "maxWidth": 480,
        "maxHeight": 160,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false,
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray-idle.png",
      "iconAsTemplate": true,
      "tooltip": "Atlas"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Atlas Contributors",
    "shortDescription": "Voice-first desktop AI assistant",
    "longDescription": "Talk to your computer. It does anything. Built on ElevenLabs and Claude."
  }
}
