# ATLAS environment template
# Copy to .env.local (gitignored) and fill in.
# Dev: load via direnv. Worker prod: wrangler secret put. Desktop prod: OS keyring.

# ──────────────── Worker (apps/worker) ────────────────
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...
ELEVENLABS_AGENT_ID=...
GEMINI_API_KEY=...
VOYAGE_API_KEY=...
BRAVE_SEARCH_API_KEY=...
OPENAI_API_KEY=sk-...

# Shared secret(s) ElevenLabs Conversational Agent presents on every custom-LLM call.
# Comma-separated to allow rotation.
ALLOWED_AGENT_TOKENS=replace-with-strong-random

# Worker self-reference (set after first deploy)
WORKER_PUBLIC_URL=https://atlas-worker.example.workers.dev

# Cost guardrails (Worker enforces; bypass needs explicit override)
DAILY_ANTHROPIC_BUDGET_USD=20
DAILY_ELEVENLABS_BUDGET_USD=15

# ──────────────── Desktop (apps/desktop) ────────────────
ATLAS_WORKER_URL=https://atlas-worker.example.workers.dev
ATLAS_AGENT_ID=...
ATLAS_PICOVOICE_ACCESS_KEY=...
ATLAS_LOG_LEVEL=info
ATLAS_TELEMETRY_OPT_IN=false

# ──────────────── Web (apps/web, later) ────────────────
WEB_PUBLIC_URL=http://localhost:3000
